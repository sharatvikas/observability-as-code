{
  "K8s: Nodes Ready": {
    "expr": "sum(kube_node_status_condition{condition=\"Ready\", status=\"true\"})",
    "series": 1,
    "sample_value": "1"
  },
  "K8s: Container Restarts 1h": {
    "expr": "sum(increase(kube_pod_container_status_restarts_total[1h])) or vector(0)",
    "series": 1,
    "sample_value": "0"
  },
  "K8s: Cluster CPU Util %": {
    "expr": "100 * sum(namespace:cpu_usage:rate5m) / sum(kube_node_status_allocatable{resource=\"cpu\"})",
    "series": 1,
    "sample_value": "2.103859772258884"
  },
  "K8s: Cluster Mem Util %": {
    "expr": "100 * sum(namespace:memory_usage:sum) / sum(kube_node_status_allocatable{resource=\"memory\"})",
    "series": 1,
    "sample_value": "19.567640890528647"
  },
  "K8s: Node CPU Util (recording rule)": {
    "expr": "100 * node:cpu_utilization:rate5m",
    "series": 1,
    "sample_value": "6.716100047029949"
  },
  "K8s: namespace:cpu_usage:rate5m (our rule)": {
    "expr": "namespace:cpu_usage:rate5m",
    "series": 3,
    "sample_value": "0.11378505626322366"
  },
  "K8s: kube_pod_status_phase": {
    "expr": "count(kube_pod_status_phase{phase=\"Running\"})",
    "series": 1,
    "sample_value": "15"
  },
  "RED: Request Rate (http_requests_total)": {
    "expr": "sum(rate(http_requests_total[5m]))",
    "series": 0,
    "sample_value": null
  },
  "SLO: error rate recording rule": {
    "expr": "job:request_error_rate:ratio_rate1h",
    "series": 0,
    "sample_value": null
  },
  "SLO: error budget remaining rule": {
    "expr": "job:error_budget_remaining:ratio_rate30d",
    "series": 0,
    "sample_value": null
  }
}